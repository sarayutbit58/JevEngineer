# ==============================================================================
# JevEngineer / TypeSafe AI Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS. NEVER COMMIT .env TO GIT!
# ==============================================================================

# TypeSafe AI API Key (Optional)
# If left blank or unset, JevClient automatically defaults to the Local Calibrated Emulator mode.
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_API_BASE=https://api.typesafe.ai/v1

# Paperclip AI Instance Configuration
PAPERCLIP_API_BASE=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=ba9c8f2b-7942-4917-aae5-8320e3a9a7c7

# Gateway Interceptor Daemon Port
GATEWAY_PORT=3105
